# =====================================================
# ToolBank AutoCAD - local environment template
# Copy this file to .env and fill in the values you use.
# .env is gitignored; .env.example is committed.
# =====================================================

# ---------- Vision sidecar LLM providers ----------
# At least one provider is required for /v1/describe-image,
# /v1/classify-drawing and /v1/architect-review.

# Anthropic Claude (used by architect-reviewer / delta-compare)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT-4o / GPT-5 family
# OPENAI_API_KEY=sk-...

# Google Gemini 3.1 Pro (frontier vision model, April 2026)
# GOOGLE_API_KEY or GEMINI_API_KEY - the SDK accepts either.
# GOOGLE_API_KEY=AIza...

# ---------- Optional: override default models / behaviour ----------
# ACADMCP_ANTHROPIC_MODEL=claude-opus-4-6
# ACADMCP_OPENAI_MODEL=gpt-5.4
# ACADMCP_GOOGLE_MODEL=gemini-3.1-pro-preview
# ACADMCP_GOOGLE_THINKING=high     # low | medium | high | max

# ---------- Budget guardrail for live architect-review sweeps ----------
# Cumulative USD budget the `scripts/run-architect-review.py` helper may
# spend in one process before it refuses further calls. Defaults to $10.
# ACADMCP_GEMINI_BUDGET_USD=10.00
