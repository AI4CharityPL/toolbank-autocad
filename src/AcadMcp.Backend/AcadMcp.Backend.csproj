<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AcadMcp.Backend</RootNamespace>
    <AssemblyName>AcadMcp.Backend</AssemblyName>
    <Description>Stdio MCP host. One binary, parameterized by --category. See rule 00-architecture-invariants.mdc.</Description>
    <PublishSingleFile>false</PublishSingleFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
  </ItemGroup>

  <!--
    Bundled validator rules + standards are shipped as embedded resources so the
    Backend exe is self-contained at runtime. Loose files under <repo>/validators/
    still take precedence in dev mode (see Validators/RuleRegistry.cs).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\validators\**\*.yaml" LinkBase="validators" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcadMcp.Shared\AcadMcp.Shared.csproj" />
    <ProjectReference Include="..\AcadMcp.SourceGen\AcadMcp.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    CheckManifestSync - verifies every code category has a matching mcpbank-manifests/acad-<name>.json
    and that tool name lists are in sync. Runs after build in Release to keep dev iteration fast.
    Skip with `-p:SkipManifestCheck=true`.
  -->
  <Target Name="CheckManifestSync"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipManifestCheck)' != 'true'">
    <PropertyGroup>
      <ManifestCheckScript>$(MSBuildThisFileDirectory)..\..\scripts\check-manifests.ps1</ManifestCheckScript>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ManifestCheckScript)&quot;"
          ContinueOnError="false"
          Condition="Exists('$(ManifestCheckScript)')" />
  </Target>

</Project>
