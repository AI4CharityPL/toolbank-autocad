<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AcadMcp.ComBridge</RootNamespace>
    <AssemblyName>AcadMcp.ComBridge</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <Description>COM/ActiveX fallback for AutoCAD LT and recovery. NEVER references acmgd.dll.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcadMcp.Shared\AcadMcp.Shared.csproj" />
  </ItemGroup>

</Project>
